# Copy to .env and fill in real values:   cp .env.example .env
# .env is gitignored — NEVER commit it.

# ── System ────────────────────────────────────────────────────────────────
# Timezone, e.g. America/Denver, America/Chicago
TZ=Etc/UTC

# Host path where recordings are stored (the ZFS pool / RAID mount —
# see docs/storage.md)
FRIGATE_MEDIA_PATH=/mnt/frigate-media

# ── MQTT (must match the user created with mosquitto_passwd) ─────────────
FRIGATE_MQTT_USER=frigate
FRIGATE_MQTT_PASSWORD=change-me

# ── Camera credentials ────────────────────────────────────────────────────
# Shared viewer account provisioned on every camera. If cameras use
# different credentials, add per-camera variables (any FRIGATE_-prefixed
# variable is usable as {FRIGATE_VAR} inside frigate/config/config.yml).
FRIGATE_CAM_USER=viewer
FRIGATE_CAM_PASSWORD=change-me

# ── Camera IPs (camera VLAN — see docs/network.md) ────────────────────────
FRIGATE_CAM_FRONT_DOOR_IP=10.20.0.101
FRIGATE_CAM_DRIVEWAY_IP=10.20.0.102
# Add one line per additional camera:
# FRIGATE_CAM_BACKYARD_IP=10.20.0.103
